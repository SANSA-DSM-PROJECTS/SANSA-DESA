# =============================================================================
# Environment for the DESA app stack (OWS, Explorer, JupyterHub)
# Merge into the app stack's .env – replaces the old remote-DB values.
# =============================================================================

# --- datacube-ows (read-only) ----------------------------------------------
# OWS serves as odc_reader. Its own "ows" schema (layer extents/ranges) must be
# created and refreshed as odc_admin, granting read to odc_reader, e.g. for 1.8.x:
#   ODC_DEFAULT_DB_URL=postgresql://odc_admin:...@desa-db/datacube \
#     datacube-ows-update --schema --role odc_reader
#   ... then datacube-ows-update   (after every indexing run)
# Check `datacube-ows-update --help` in your image – the flags vary by version.
ODC_DEFAULT_DB_URL=postgresql://odc_reader:CHANGE_ME@desa-db:5432/datacube
DB_HOSTNAME=desa-db
DB_PORT=5432
DB_DATABASE=datacube
DB_USERNAME=odc_reader
DB_PASSWORD=CHANGE_ME

# --- ODC Explorer -----------------------------------------------------------
# Web app and cubedash-gen both use the explorer role.
EXPLORER_DB_URL=postgresql://odc_explorer:CHANGE_ME@desa-db:5432/datacube

# --- JupyterHub single-user notebooks (read-only) -----------------------------
JUPYTER_ODC_DB_URL=postgresql://odc_reader:CHANGE_ME@desa-db:5432/datacube
