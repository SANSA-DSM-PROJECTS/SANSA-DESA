<style>

  /* =========================
     DESA TERRIA NAVIGATION
  ========================= */

  .desa-main-nav {
    height: 72px;
    width: 100%;
    background: #ffffff;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 999999;
    box-shadow: 0 2px 12px rgba(0,0,0,.08);
  }

  .desa-nav-inner {
    max-width: 1200px;
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .desa-brand {
    display: flex;
    align-items: center;
    height: 100%;
  }

  .desa-brand img {
    width: 90px;
    height: auto;
    display: block;
  }

  .desa-nav-links {
    display: flex;
    align-items: center;
    height: 100%;
    gap: 30px;
  }

  .desa-nav-links a {
    position: relative;
    color: #0b2a57;
    text-decoration: none;
    font-family: Arial, sans-serif;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }

  .desa-nav-links a:hover {
    color: #1f66b3;
  }

  .desa-nav-links a.active {
    color: #0b2a57;
  }

  .desa-nav-links a.active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -25px;
    height: 3px;
    background: #1f66b3;
  }

  /*
   * Move TerriaJS below DESA navbar
   */
  #ui {
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    bottom: 0;
  }

</style>

  </head>

  <body>

<header class="desa-main-nav">
  <div class="desa-nav-inner">

<a class="desa-brand" href="https://desa.sansa.org.za/">
  <img src="images/desa_logo.PNG" alt="Digital Earth SA">
</a>

<nav class="desa-nav-links">
  <a href="https://desa.sansa.org.za/">Home</a>
  <a href="https://desa.sansa.org.za/about-us">About Us</a>
  <a href="https://desa.sansa.org.za/analysis-ready-data">Analysis Ready Data</a>
  <a href="https://desa.sansa.org.za/platforms" class="active">Platforms</a>
  <a href="https://desa.sansa.org.za/decision-support-tools">Decision Support Tools</a>
  <a href="https://desa.sansa.org.za/help">Help</a>
  <a href="https://desa.sansa.org.za/contact">Contact Us</a>
</nav>

  </div>
</header>

<div id="ui"></div>

<script src="build/TerriaMap.js"></script>

    <div id="svg-sprites" style="display: none"></div>
    <div id="ui"></div>
  </body>
