        {
            "name": "Water Indices",
            "type": "group",
            "description": "Monthly national mosaics of water quality indicators for South African surface water bodies, derived from Sentinel-2 imagery at 20 m resolution.",
            "members": [
                {
                    "type": "wms",
                    "name": "Chlorophyll (NDCI)",
                    "url": "https://desa-ows.sansa.org.za/wms",
                    "layers": "dst_water_indeces",
                    "styles": "ndci",
                    "opacity": 0.85,
                    "info": [
                        {
                            "name": "About",
                            "content": "Normalised Difference Chlorophyll Index. Correlates with chlorophyll-a concentration and algal bloom risk."
                        }
                    ]
                },
                {
                    "type": "wms",
                    "name": "Turbidity (NDTI)",
                    "url": "https://desa-ows.sansa.org.za/wms",
                    "layers": "dst_water_indeces",
                    "styles": "ndti",
                    "opacity": 0.85,
                    "info": [
                        {
                            "name": "About",
                            "content": "Normalised Difference Turbidity Index. Higher values indicate greater suspended sediment."
                        }
                    ]
                },
                {
                    "type": "wms",
                    "name": "Algal Bloom Index (ABI)",
                    "url": "https://desa-ows.sansa.org.za/wms",
                    "layers": "dst_water_indeces",
                    "styles": "abi",
                    "opacity": 0.85,
                    "info": [
                        {
                            "name": "About",
                            "content": "Algal Bloom Index. Indicates the severity of algal bloom conditions."
                        }
                    ]
                },
                {
                    "type": "wms",
                    "name": "Water extent (AWEI)",
                    "url": "https://desa-ows.sansa.org.za/wms",
                    "layers": "dst_water_indeces",
                    "styles": "awei",
                    "opacity": 0.85,
                    "info": [
                        {
                            "name": "About",
                            "content": "Automated Water Extraction Index. Positive values indicate the presence of open water."
                        }
                    ]
                },
                {
                    "type": "wms",
                    "name": "Total Suspended Solids (TSS)",
                    "url": "https://desa-ows.sansa.org.za/wms",
                    "layers": "dst_water_indeces",
                    "styles": "tss",
                    "opacity": 0.85,
                    "info": [
                        {
                            "name": "About",
                            "content": "Total Suspended Solids concentration in grams per cubic metre."
                        }
                    ]
                },
                {
                    "type": "wms",
                    "name": "Total Dissolved Solids (TDS)",
                    "url": "https://desa-ows.sansa.org.za/wms",
                    "layers": "dst_water_indeces",
                    "styles": "tds",
                    "opacity": 0.85,
                    "info": [
                        {
                            "name": "About",
                            "content": "Total Dissolved Solids concentration in milligrams per litre."
                        }
                    ]
                },
                {
                    "type": "wms",
                    "name": "Floating Algae (FAI)",
                    "url": "https://desa-ows.sansa.org.za/wms",
                    "layers": "dst_water_indeces",
                    "styles": "fai",
                    "opacity": 0.85,
                    "info": [
                        {
                            "name": "About",
                            "content": "Floating Algae Index. Detects floating algae and vegetation on the water surface."
                        }
                    ]
                }
            ]
