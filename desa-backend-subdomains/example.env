# =============================================================
# DESA backend — environment template
# =============================================================
# Copy to `.env` and fill in real values:
#     cp example.env .env
# `.env` is gitignored and must never be committed.
# =============================================================

################
# PostgreSQL / Open Data Cube index
################
PGDB_HOSTNAME=
PGDB_USERNAME=
PGDB_PASSWORD=
PGDB_DATABASE=desadb_dev

################
# Object storage (S3 / MinIO)
################
# Must be a REAL AWS region name, even though MinIO itself ignores it --
# GDAL builds real-AWS hostnames as <bucket>.s3.<region>.amazonaws.com, so an
# invented value (e.g. "af-africa-1") silently breaks all public-AWS access
# while appearing to work for MinIO. af-south-1 = Cape Town, which is also
# where the Digital Earth Africa public buckets live.
AWS_REGION=af-south-1

# "yes" for anonymous access to public buckets (e.g. real AWS open data).
# "no"  when the bucket requires credentials — which is the case for the
#       on-prem MinIO data lake below.
AWS_NO_SIGN_REQUEST=no

# S3 endpoint. Leave EMPTY to use real AWS S3.
# Set to host:port to point GDAL/boto3 at an on-prem MinIO instead.
# NOTE: this is a per-container global. It cannot simultaneously serve
# unsigned real-AWS buckets and a signed private MinIO — see README.
AWS_S3_ENDPOINT=10.150.16.133:9000

################
# MinIO (DSM data lake) credentials
################
# Required when AWS_S3_ENDPOINT points at MinIO and AWS_NO_SIGN_REQUEST=no.
# Consumed by desa-ows (as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) and
# by product-generation/generate_and_store_datasets.py
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

################
# pgAdmin (only used by docker-compose-npm.yaml / desa-jupyterhub)
################
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
