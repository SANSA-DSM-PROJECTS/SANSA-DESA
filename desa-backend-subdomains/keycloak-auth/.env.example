# =========================================================================
# DEV secrets & environment for the Keycloak stack (docker-compose.yml).
#
# Copy this file to `.env` and fill in values. `.env` is git-ignored
# (**/.env) — never commit it. Docker Compose auto-loads `.env` from this
# directory when you run `docker compose up`.
#
# For production, use `.env.prod` with `docker-compose.prod.yml` instead
# (see .env.prod.example).
# =========================================================================

# --- Public hostname (what browsers use, behind the nginx TLS proxy) --------
# Must match the nginx server_name and every app's OIDC authority.
KC_HOSTNAME=https://dlula-dev.sansa.org.za

# --- Database ---------------------------------------------------------------
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
# Generate a strong value, e.g.  openssl rand -base64 32
KC_DB_PASSWORD=CHANGE_ME_db_password

# --- First-boot bootstrap admin ---------------------------------------------
# Only used the first time the master realm has no admin.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
# Generate a strong value, e.g.  openssl rand -base64 24
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password
